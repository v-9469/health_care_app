# Django Configuration
SECRET_KEY=django-insecure-healthcare-super-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Database Connection Pool Lifetime in Seconds
DB_CONN_MAX_AGE=600

# Fallback to SQLite if PostgreSQL connection fails
DB_USE_SQLITE_FALLBACK=True

# JWT Token Lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=1
